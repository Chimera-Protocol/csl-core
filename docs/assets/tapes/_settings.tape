# Shared look for the README recordings. Run each tape from the repository root, after
# `bash docs/assets/tapes/prepare.sh`, with cslcore on PATH.
Set Shell "bash"
Set FontSize 15
Set Width 1000
Set Height 780
Set Padding 22
Set Margin 0
Set WindowBar Colorful
Set BorderRadius 10
Set TypingSpeed 40ms
Set Framerate 20
Set Theme { "name": "csl", "background": "#0b1120", "foreground": "#cbd5e1", "cursor": "#5eead4", "selection": "#1e3a5f", "black": "#0f172a", "red": "#f87171", "green": "#4ade80", "yellow": "#fbbf24", "blue": "#60a5fa", "magenta": "#e879f9", "cyan": "#5eead4", "white": "#e2e8f0", "brightBlack": "#475569", "brightRed": "#fca5a5", "brightGreen": "#86efac", "brightYellow": "#fde68a", "brightBlue": "#93c5fd", "brightMagenta": "#f0abfc", "brightCyan": "#99f6e4", "brightWhite": "#f8fafc" }
